[Unit]
Description=Squeezebox Jive UI + playback (SqueezePlay)
After=splash.service wifi.service sound.target network.target
Wants=splash.service wifi.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
# DRM handoff: stop the splash painter so Jive becomes DRM master
# (ui/splash/SERVICE_HOOKS.md; '-' tolerates "already gone").
ExecStartPre=-/opt/squeezeplay/bin/init-splash.sh stop
ExecStart=/usr/lib/squeezebox/squeezeplay.sh
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
# Jive needs input + DRM + ALSA devices.
DeviceAllow=/dev/input/* rw
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/snd/* rw
DeviceAllow=/dev/tty1 rw

[Install]
WantedBy=multi-user.target
