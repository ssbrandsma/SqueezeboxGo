# Pinned boot-chain sources for Squeezebox RG35XX H (Agent 1, WP1).
# Verified 2026-11-15 against kernel.org, git.kernel.org, github.com/u-boot,
# github.com/ARM-software. Lead approval required to change (see
# docs/upstream-references/upstream-manifest.md).
#
# Shell-includable: `set -a; . pins.env; set +a` (see fetch.sh).
# No secrets in this file.

# --- Linux (stable tree; torvalds/linux.git carries mainline tags only) ---
LINUX_VERSION=7.3.4
LINUX_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_TAG=v7.3.4
LINUX_SHA=8310b43a724c54668eeaa6860234078a7886915a
LINUX_TARBALL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.3.4.tar.xz
# Published by kernel.org in v7.x/sha256sums.asc (fetched 2026-11-15):
LINUX_TARBALL_SHA256=b11b6df8295e8e991ff040b71aaa4994a8b55caa23b6b092907f195b5840fd1f

# --- U-Boot (release tag; peeled commit verified via ls-remote) ---
UBOOT_VERSION=2026.10
UBOOT_REPO=https://github.com/u-boot/u-boot.git
UBOOT_TAG=v2026.10
UBOOT_TAG_SHA=a58e2b7af42c179ace2c6210de0a219fa3f3cf3c
UBOOT_SHA=5508406582f6f7120dce0c4b3059819a41788db2
UBOOT_DEFCONFIG=anbernic_rg35xx_h700_defconfig
# Observed 2026-11-15 GitHub codeload hash (NOT stable-guaranteed; builds
# verify the git SHA above, this is a download sanity check only):
UBOOT_TARBALL_SHA256=f943a88389c8fd70a6b0d061a88267465e143c7ca6ea2b75837ab20f5b60c739

# --- ARM Trusted Firmware (BL31 for sunxi H616/H700) ---
ATF_VERSION=2.15.0
ATF_REPO=https://github.com/ARM-software/arm-trusted-firmware.git
ATF_TAG=v2.15.0
ATF_TAG_SHA=9ad327a8d124ce82002614c23e33992d4de6f7cf
ATF_SHA=da738d5eae93af342fdc4995dd3c05acb4c9d757
ATF_PLAT=sun50i_h616
ATF_TARBALL_SHA256=ec4d6779225c5243a05dd190cd25c06ae79bec293afea780f0eb63541341a505

# --- Build contract (docs/interface-contracts.md) ---
TARGET_TRIPLET=aarch64-linux-gnu
KARCH=arm64
KCROSS_COMPILE=aarch64-linux-gnu-
KCFLAGS='-march=armv8-a+crc -mtune=cortex-a53'
# Reproducibility: override per release; default keeps local builds working.
SOURCE_DATE_EPOCH_DEFAULT=1794334272
