[Unit]
Description=Squeezebox standalone source %i
After=squeezeplay.service sound.target network.target
Wants=sound.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
# Same state dirs the adapters default to; explicit so the unit is
# self-describing. AUDIO_OWNER_BIN is the Agent-3 arbiter install path.
Environment=PID_DIR=/run/squeezebox NP_STATE_DIR=/run/squeezebox AUDIO_OWNER_BIN=/usr/sbin/audio-owner
ExecStart=/usr/lib/squeezebox/standalone/base/adapter.sh %i start /etc/squeezebox/standalone/services/%i
ExecStop=/usr/lib/squeezebox/standalone/base/adapter.sh %i stop /etc/squeezebox/standalone/services/%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=squeezebox-standalone.target
