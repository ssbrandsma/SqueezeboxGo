From: Squeezebox RG35XX H Agent 2 (Core)
Subject: [PATCH 2/3] squeezeplay: git-revcount version.h, overridable release
Upstream: squeezeplay@758bc11 src/squeezeplay/{Makefile.am,Makefile.in}
Rationale: upstream rule needs svnversion (absent on git checkouts); take revision
 from "git rev-list HEAD --count" with svnversion/unknown fallback. Release stays
 squeezeplay.version unless SQUEEZEPLAY_RELEASE is set (contract knob).
Apply: patch -p1 < 0002-squeezeplay-git-revcount-version.patch (from upstream repo root)
---

diff --git a/src/squeezeplay/Makefile.am b/src/squeezeplay/Makefile.am
index 6812ff1d..55c37c3f 100644
--- a/src/squeezeplay/Makefile.am
+++ b/src/squeezeplay/Makefile.am
@@ -157,10 +157,10 @@ BUILT_SOURCES = \
 src/version.h: FORCE
 	@echo '/* This file is automatically generated */' > src/version.h
 	@echo '#ifndef SQUEEZEPLAY_RELEASE' >> src/version.h
-	@echo '#define SQUEEZEPLAY_RELEASE "'`cat ../squeezeplay.version`'"' >> src/version.h
+	@echo '#define SQUEEZEPLAY_RELEASE "'`[ -n "$(SQUEEZEPLAY_RELEASE)" ] && echo "$(SQUEEZEPLAY_RELEASE)" || cat ../squeezeplay.version`'"' >> src/version.h
 	@echo '#endif' >> src/version.h
 	@echo '#ifndef SQUEEZEPLAY_REVISION' >> src/version.h
-	@echo '#define SQUEEZEPLAY_REVISION "'`svnversion -n .. | sed -e 's/[MS]//g'`'"' >> src/version.h
+	@echo '#define SQUEEZEPLAY_REVISION "'`(git -C .. rev-list HEAD --count 2>/dev/null || svnversion -n .. 2>/dev/null || echo unknown) | sed -e 's/[MS]//g'`'"' >> src/version.h
 	@echo '#endif' >> src/version.h
 	@echo '#define JIVE_VERSION SQUEEZEPLAY_RELEASE" r"SQUEEZEPLAY_REVISION' >> src/version.h
 
diff --git a/src/squeezeplay/Makefile.in b/src/squeezeplay/Makefile.in
index 31e9a48c..8876a6aa 100644
--- a/src/squeezeplay/Makefile.in
+++ b/src/squeezeplay/Makefile.in
@@ -1348,10 +1348,10 @@ squeezeplay-deb:
 src/version.h: FORCE
 	@echo '/* This file is automatically generated */' > src/version.h
 	@echo '#ifndef SQUEEZEPLAY_RELEASE' >> src/version.h
-	@echo '#define SQUEEZEPLAY_RELEASE "'`cat ../squeezeplay.version`'"' >> src/version.h
+	@echo '#define SQUEEZEPLAY_RELEASE "'`[ -n "$(SQUEEZEPLAY_RELEASE)" ] && echo "$(SQUEEZEPLAY_RELEASE)" || cat ../squeezeplay.version`'"' >> src/version.h
 	@echo '#endif' >> src/version.h
 	@echo '#ifndef SQUEEZEPLAY_REVISION' >> src/version.h
-	@echo '#define SQUEEZEPLAY_REVISION "'`svnversion -n .. | sed -e 's/[MS]//g'`'"' >> src/version.h
+	@echo '#define SQUEEZEPLAY_REVISION "'`(git -C .. rev-list HEAD --count 2>/dev/null || svnversion -n .. 2>/dev/null || echo unknown) | sed -e 's/[MS]//g'`'"' >> src/version.h
 	@echo '#endif' >> src/version.h
 	@echo '#define JIVE_VERSION SQUEEZEPLAY_RELEASE" r"SQUEEZEPLAY_REVISION' >> src/version.h
 
